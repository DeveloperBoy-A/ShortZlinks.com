<%- include('partials/header') %>
<main class="flex-grow p-6 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-3xl mx-auto my-6">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-black mb-2"><i class="fas fa-check-double text-primary mr-2"></i> Payment Proofs</h1>
            <p class="text-gray-500 dark:text-gray-400">Discover the successful payments we've made to our users!</p>
        </div>

        <div class="rounded-xl overflow-hidden shadow-lg">
            <div class="bg-gradient-to-r from-primary to-secondary text-white p-6 flex items-center gap-4">
                <i class="fas fa-money-check-alt text-3xl"></i>
                <h2 class="text-2xl font-bold">Recent Withdrawals</h2>
            </div>

            <div class="bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700">
                <% if (proofs && proofs.length) { %>
                    <% proofs.forEach(function(p){ %>
                        <div class="p-5 border-l-4 border-green-400">
                            <div class="grid grid-cols-2 gap-y-2 text-sm">
                                <span class="font-bold text-gray-500">Date</span>
                                <span class="text-gray-800 dark:text-gray-200 text-right"><%= new Date(p.date).toLocaleString() %></span>

                                <span class="font-bold text-gray-500">Username</span>
                                <span class="text-gray-800 dark:text-gray-200 text-right"><%= p.username %></span>

                                <span class="font-bold text-gray-500">Amount</span>
                                <span class="text-green-600 font-black text-right">$<%= Number(p.amount).toFixed(4) %></span>

                                <span class="font-bold text-gray-500">Method</span>
                                <span class="text-gray-800 dark:text-gray-200 text-right"><%= p.method %></span>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-10 text-center text-gray-500">
                        <i class="fas fa-inbox text-3xl mb-3 block"></i> No payment proofs yet â€” check back soon!
                    </div>
                <% } %>
            </div>

            <% if (totalPages > 1) { %>
                <div class="bg-white dark:bg-gray-800 p-4 flex justify-center items-center gap-2 border-t dark:border-gray-700 flex-wrap">
                    <% if (page > 1) { %>
                        <a href="/payment-proofs?page=<%= page - 1 %>" class="px-3 py-1.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 font-bold text-sm hover:bg-gray-200 transition">&laquo; Prev</a>
                    <% } %>
                    <span class="px-3 py-1.5 rounded bg-primary text-white font-bold text-sm">Page <%= page %> of <%= totalPages %></span>
                    <% if (page < totalPages) { %>
                        <a href="/payment-proofs?page=<%= page + 1 %>" class="px-3 py-1.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 font-bold text-sm hover:bg-gray-200 transition">Next &raquo;</a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</main>
<%- include('partials/footer') %>