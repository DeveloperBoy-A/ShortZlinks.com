<%- include('partials/header') %>
<main class="flex-grow p-6 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-3xl mx-auto my-6">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-black mb-2"><i class="fas fa-envelope-open-text text-primary mr-2"></i> Contact Us</h1>
            <p class="text-gray-500 dark:text-gray-400">Reach out for support or join our channels for the latest updates from <%= siteName %>.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 flex gap-4 items-start">
                <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl shrink-0">
                    <i class="fas fa-envelope"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-1">Email Support</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Contact our team directly for assistance.</p>
                    <a href="mailto:<%= supportEmail %>" class="text-primary font-semibold hover:underline break-all"><%= supportEmail %></a>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 flex gap-4 items-start">
                <div class="w-12 h-12 rounded-full bg-sky-100 dark:bg-sky-900/30 text-sky-500 flex items-center justify-center text-xl shrink-0">
                    <i class="fab fa-telegram-plane"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-1">Telegram Support</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Get quick help via Telegram messaging.</p>
                    <a href="https://t.me/YourBotName" target="_blank" class="text-primary font-semibold hover:underline">@<%= siteName %>Support</a>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 flex gap-4 items-start">
                <div class="w-12 h-12 rounded-full bg-green-100 dark:bg-green-900/30 text-green-500 flex items-center justify-center text-xl shrink-0">
                    <i class="fab fa-whatsapp"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-1">WhatsApp Channel</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Join for news and announcements.</p>
                    <a href="javascript:void(0);" class="text-primary font-semibold hover:underline">Join WhatsApp Channel</a>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 flex gap-4 items-start">
                <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-500 flex items-center justify-center text-xl shrink-0">
                    <i class="fab fa-telegram"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-1">Telegram Channel</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Follow for updates and notifications.</p>
                    <a href="javascript:void(0);" class="text-primary font-semibold hover:underline">Join Telegram Channel</a>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 flex gap-4 items-start md:col-span-2">
                <div class="w-12 h-12 rounded-full bg-indigo-100 dark:bg-indigo-900/30 text-indigo-500 flex items-center justify-center text-xl shrink-0">
                    <i class="fab fa-discord"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-1">Discord Community</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Join our community on Discord.</p>
                    <a href="javascript:void(0);" class="text-primary font-semibold hover:underline">Join Discord Community</a>
                </div>
            </div>

        </div>

        <p class="text-center text-sm text-gray-400 mt-8">
            <i class="fas fa-info-circle mr-1"></i> Use email or Telegram for support inquiries. Join our WhatsApp, Telegram, or Discord channels for updates and announcements. We're here to help!
        </p>
    </div>
</main>
<%- include('partials/footer') %>