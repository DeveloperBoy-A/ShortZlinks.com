<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        let timeLeft = 10; // 10 seconds timer
        const timerDisplay = document.getElementById('timerDisplay');
        const instructionText = document.getElementById('instructionText');
        const continueBtn = document.getElementById('continueBtn');
        const token = "<%= token %>";

        const countdown = setInterval(() => {
            timeLeft--;
            if(timerDisplay) timerDisplay.innerText = timeLeft;
            
            if (timeLeft <= 0) {
                clearInterval(countdown);
                if(timerDisplay) timerDisplay.innerText = "0";
                if(instructionText) instructionText.innerText = "Processing request securely...";
                
                fetch('/l/step/process', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ t: token })
                })
                .then(res => res.json().then(data => ({ ok: res.ok, data })))
                .then(({ ok, data }) => {
                    if (ok && data.nextUrl) {
                        if(timerDisplay) timerDisplay.parentElement.style.display = 'none';
                        if(instructionText) instructionText.innerText = "Verification Complete! Redirecting...";
                        continueBtn.href = data.nextUrl;
                        continueBtn.classList.remove('hidden');

                        gsap.to(continueBtn, { scale: 1.03, repeat: -1, yoyo: true, duration: 0.6 });

                        // Auto-advance so people don't get stuck waiting â€” the button remains as a manual fallback
                        setTimeout(() => { window.location.href = data.nextUrl; }, 1800);
                    } else {
                        if(instructionText) instructionText.innerText = "Session expired â€” please click the link again from the original page.";
                        if(continueBtn) {
                            continueBtn.textContent = 'Retry';
                            continueBtn.href = window.location.href;
                            continueBtn.classList.remove('hidden');
                        }
                    }
                })
                .catch(err => {
                    if(instructionText) instructionText.innerText = "Network error â€” tap Retry.";
                    if(continueBtn) {
                        continueBtn.textContent = 'Retry';
                        continueBtn.href = window.location.href;
                        continueBtn.classList.remove('hidden');
                    }
                });
            }
        }, 1000);
    });
</script>

