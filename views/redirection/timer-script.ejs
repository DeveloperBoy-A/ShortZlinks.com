<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        let timeLeft = 10; // 10 seconds timer
        const timerDisplay = document.getElementById('timerDisplay');
        const instructionText = document.getElementById('instructionText');
        const continueBtn = document.getElementById('continueBtn');
        const token = "<%= token %>";

        // Initial state text with emoji
        if(instructionText) instructionText.innerHTML = "🔍 Analyzing traffic quality securely...";

        const countdown = setInterval(() => {
            timeLeft--;
            if(timerDisplay) timerDisplay.innerText = timeLeft;
            
            // Timer Alert Effect: Jab 3 second bachenge toh timer ka color change hoga (optional premium feel)
            if (timeLeft <= 3 && timerDisplay) {
                timerDisplay.classList.remove('text-blue-500', 'text-green-500');
                timerDisplay.classList.add('text-red-600');
            }

            if (timeLeft <= 0) {
                clearInterval(countdown);
                if(timerDisplay) timerDisplay.innerText = "0";
                
                // Processing text with emoji
                if(instructionText) {
                    instructionText.innerHTML = "⏳ Processing your request securely...";
                    instructionText.classList.remove('text-red-600');
                    instructionText.classList.add('text-blue-600');
                }
                
                fetch('/l/step/process', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ t: token })
                })
                .then(res => res.json().then(data => ({ ok: res.ok, data })))
                .then(({ ok, data }) => {
                    if (ok && data.nextUrl) {
                        // Verification Complete State
                        if(timerDisplay) timerDisplay.parentElement.style.display = 'none';
                        
                        if(instructionText) {
                            instructionText.innerHTML = "✅ Verification Complete! Please click the button below. 👇";
                            instructionText.classList.remove('animate-pulse', 'text-gray-500', 'text-blue-600');
                            instructionText.classList.add('text-green-600', 'text-lg'); // Make it green and slightly bigger
                        }
                        
                        continueBtn.href = data.nextUrl;
                        continueBtn.innerHTML = 'Continue to Next Step <i class="fas fa-arrow-right ml-2"></i>';
                        continueBtn.classList.remove('hidden');

                        // Enhanced GSAP Animation (Smooth pulse effect)
                        gsap.to(continueBtn, { scale: 1.05, repeat: -1, yoyo: true, duration: 0.8, ease: "power1.inOut" });

                    } else {
                        // Error/Expired State
                        if(instructionText) {
                            instructionText.innerHTML = "⚠️ Session expired! Please click the link again from the original page.";
                            instructionText.classList.remove('animate-pulse', 'text-gray-500', 'text-blue-600');
                            instructionText.classList.add('text-red-500');
                        }
                        if(continueBtn) {
                            continueBtn.innerHTML = '🔄 Retry';
                            continueBtn.href = window.location.href;
                            continueBtn.classList.remove('hidden');
                        }
                    }
                })
                .catch(err => {
                    // Network Error State
                    if(instructionText) {
                        instructionText.innerHTML = "🌐 Network error! Please check your connection and tap Retry.";
                        instructionText.classList.remove('animate-pulse', 'text-gray-500', 'text-blue-600');
                        instructionText.classList.add('text-red-500');
                    }
                    if(continueBtn) {
                        continueBtn.innerHTML = '🔄 Retry Connection';
                        continueBtn.href = window.location.href;
                        continueBtn.classList.remove('hidden');
                    }
                });
            }
        }, 1000);
    });
</script>
