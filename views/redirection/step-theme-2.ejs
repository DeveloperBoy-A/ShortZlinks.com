        font-weight: 700;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }

    .article-image {
        width: 100%;
        border-radius: 12px;
        margin: 2rem 0;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        object-fit: cover;
    }

    /* Ad Placeholders */
    .ad-slot {
        width: 100%;
        background-color: #e5e7eb;
        border: 2px dashed #9ca3af;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-weight: 600;
        margin: 2rem 0;
        border-radius: 8px;
    }
    .ad-responsive { min-height: 250px; }
    .ad-banner { height: 90px; }

    /* Verification Box Styling */
    .verify-box {
        background: linear-gradient(to right, #eff6ff, #dbeafe);
        border: 2px solid #bfdbfe;
        border-radius: 12px;
        padding: 24px 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
</style>

