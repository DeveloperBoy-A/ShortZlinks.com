<!-- Backend Timer Script -->
<%- include('timer-script') %>

<!-- Fixed Mobile Bridge Logic (No auto-click/redirect from this frontend code) -->
<script>
    const customLogic = setInterval(() => {
        const timerVal = document.getElementById('timerDisplay').innerText;
        const continueBtn = document.getElementById('continueBtn');
        const scrollBtn = document.getElementById('scroll-btn');
        const waitingText = document.getElementById('bottom-waiting-text');
        
        // Use Tailwind classes instead of inline styles to prevent mobile layout breaking
        if (timerVal === "0" || timerVal === 0 || !continueBtn.classList.contains('hidden')) {
            // Show top scroll button
            scrollBtn.classList.remove('hidden');
            scrollBtn.classList.add('flex');
            
            // Hide "Please wait" text at the bottom
            waitingText.classList.add('hidden');
            
            // Ensure continueBtn displays properly as flex on mobile if unhidden by timer-script
            if(!continueBtn.classList.contains('hidden')) {
                continueBtn.classList.add('flex');
            }

            clearInterval(customLogic);
        }
    }, 500);

    // Smooth Scroll function
    function scrollToBottom() {
        document.getElementById('bottom-verify-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
</script>

