<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f9fafb;
        color: #374151;
    }
    
    .article-body p {
        margin-bottom: 1.5rem;
        line-height: 1.8;
        font-size: 1.05rem;
    }
    
    .article-body h2, .article-body h3 {
