<!-- Script for Checkbox and Verification Logic -->
<script>
// Logic to handle Custom reCAPTCHA
function verifyCaptcha() {
    const checkmark = document.getElementById('captcha-checkmark');
    const spinner = document.getElementById('captcha-spinner');
    const box = document.getElementById('captcha-checkbox');
    const recaptchaContainer = document.getElementById('captcha-box');
    const instruction = document.getElementById('captcha-instruction');
    const step1Box = document.getElementById('step1-box');
    
    // Prevent double clicking
    if(box.classList.contains('verified')) return;
    
    // 1. Show spinner
    spinner.classList.remove('hidden');
    box.classList.add('verified'); 
    
    setTimeout(() => {
        // 2. Hide spinner, show green tick
        spinner.classList.add('hidden');
        checkmark.classList.remove('hidden');
        box.style.border = "none";
        
        setTimeout(() => {
            // 3. Fade out recaptcha box
            recaptchaContainer.style.opacity = '0';
            if(instruction) instruction.style.opacity = '0';
            
            setTimeout(() => {
                // 4. Hide recaptcha completely, SHOW TIMER
                recaptchaContainer.style.display = 'none';
                if(instruction) instruction.style.display = 'none';
                
                step1Box.classList.remove('hidden');
                step1Box.classList.add('flex'); // Switch to flex layout
            }, 300);
        }, 600);
    }, 1000);
}

// Preserved original timer logic
document.addEventListener("DOMContentLoaded", function() { 
    const timerValElement = document.getElementById('timerDisplay'); 
    const continueBtn = document.getElementById('continueBtn'); 
    const scrollBtn = document.getElementById('scroll-btn'); 
    const waitingText = document.getElementById('bottom-waiting-text'); 

    const customLogic = setInterval(() => { 
        if (!timerValElement || !continueBtn) return; 
        
        const timerVal = timerValElement.innerText.trim(); 
        const btnNotHidden = !continueBtn.classList.contains('hidden'); 
        const hrefUpdated = continueBtn.getAttribute('href') !== '#' && continueBtn.getAttribute('href') !== ''; 

        if (timerVal === "0" || timerVal === 0 || timerVal === "" || btnNotHidden || hrefUpdated) { 
            // Show top Scroll Button 
            if(scrollBtn) { 
                scrollBtn.classList.remove('hidden'); 
                scrollBtn.style.display = 'flex'; 
            } 
            
            // Hide waiting text 
            if(waitingText) { 
                waitingText.style.display = 'none'; 
            } 
            
            // Show bottom continue button 
            if(continueBtn) { 
                continueBtn.classList.remove('hidden'); 
                continueBtn.style.display = 'flex'; 
            } 
            
            clearInterval(customLogic); 
        } 
    }, 500); 
});
</script>
