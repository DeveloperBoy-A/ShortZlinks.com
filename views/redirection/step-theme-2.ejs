<!-- Backend Timer Script -->
<%- include('timer-script') %>

<!-- FIX 3: Updated Custom Bridge Logic for Flawless Triggering -->
<script>
    const customLogic = setInterval(() => {
        const timerValElement = document.getElementById('timerDisplay');
        const continueBtn = document.getElementById('continueBtn');
        const scrollBtn = document.getElementById('scroll-btn');
        const waitingText = document.getElementById('bottom-waiting-text');
        
        if (!timerValElement || !continueBtn) return;
        
        const timerVal = timerValElement.innerText;
        
        // If timer reached 0 OR backend script removed the hidden class from continue button
        if (timerVal === "0" || timerVal === 0 || !continueBtn.classList.contains('hidden')) {
            
            // 1. Show the top scroll button properly
            scrollBtn.classList.remove('hidden');
            scrollBtn.style.display = 'flex'; // Force display flex
            
            // 2. Hide the bottom waiting text completely
            waitingText.style.display = 'none';
            
            // 3. Force the continue button to show properly at the bottom
            continueBtn.classList.remove('hidden');
            continueBtn.style.display = 'flex'; // Force display flex to overwrite Tailwind classes if needed
            
            clearInterval(customLogic);
        }
    }, 500);

    // Smooth Scroll function
    function scrollToBottom() {
        document.getElementById('bottom-verify-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
</script>

