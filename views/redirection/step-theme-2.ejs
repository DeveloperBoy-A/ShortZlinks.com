            <a id="continueBtn" href="#" class="hidden w-full max-w-md mx-auto bg-gradient-to-r from-green-500 to-emerald-600 text-white py-5 px-6 rounded-2xl font-black text-xl hover:from-green-600 hover:to-emerald-700 hover:shadow-xl transition-all hover:-translate-y-1 shadow-lg flex items-center justify-center tracking-wide relative z-50 clickable-btn border border-green-400 border-opacity-40">
                Continue to Next Step
                <svg class="w-6 h-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
            
            <p class="text-xs text-gray-400 mt-6 font-medium">By continuing, you agree to our verified terms of service.</p>
        </div>

        <!-- Bottom Ad -->
        <div class="ad-wrapper mb-0 mt-12">
            <span class="ad-label">Advertisement</span>
            <div class="ad-slot ad-rectangle">[ Bottom Ad ]</div>
        </div>

    </div>

    <!-- Right Column Sidebar -->
