                </ul>
            </div>
            
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mb-6">
                <h3 class="text-lg font-bold border-b pb-2 mb-4">Sponsored</h3>
                <!-- Sidebar Ad 2 -->
                <div class="ad-slot ad-responsive h-96 w-full m-0">
                    [ Vertical Skyscraper Ad ]
                </div>
            </div>
        </div>
    </aside>

</main>

<footer class="bg-gray-900 text-gray-400 text-center py-6 mt-12 text-sm">
    <p>Copyright © 2026 ShortInvest | Powered by Astra WordPress Theme</p>
