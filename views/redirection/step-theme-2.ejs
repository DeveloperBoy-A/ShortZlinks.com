                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path>
                </svg>
            </div>
            <h3 class="text-3xl font-extrabold text-gray-900 mb-4 tracking-tight">Destination Link Ready</h3>
            
            <div id="bottom-waiting-text" class="text-gray-500 font-semibold mb-6 h-12 flex items-center justify-center bg-gray-200 py-3 px-6 rounded-xl animate-pulse text-sm md:text-base border border-gray-300">
