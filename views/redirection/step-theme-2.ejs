    /* Specific Ad Sizes */
    .ad-rectangle { height: 250px; width: 100%; }
    .ad-square { height: 300px; width: 300px; margin: 0 auto; }
    .ad-leaderboard { height: 120px; width: 100%; }
    .ad-native { height: 150px; width: 100%; display: flex; flex-direction: row; gap: 1rem; padding: 1rem; text-align: left; }
    .ad-native-img { width: 120px; height: 100%; background-color: #e2e8f0; border-radius: 0.5rem; flex-shrink: 0; }
    .ad-native-text { flex-grow: 1; display: flex; flex-direction: column; justify-content: center; }
    
    /* Verification Box Styling */
    .verify-box { 
        background: linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%); 
