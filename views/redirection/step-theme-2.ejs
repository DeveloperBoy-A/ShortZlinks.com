        position: relative; 
        overflow: hidden; 
    }

    .verify-box::before { 
        content: ''; 
        position: absolute; 
        top: 0; left: 0; 
        width: 100%; height: 5px; 
        background: linear-gradient(90deg, #22c55e, #10b981, #047857); 
    }

    .clickable-btn { 
        position: relative; 
        z-index: 100 !important; 
        pointer-events: auto !important; 
