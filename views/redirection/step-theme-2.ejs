<!-- Tailwind CSS (Ensures styling works immediately) -->
<script src="https://cdn.tailwindcss.com"></script>

<style>
    html { 
        scroll-behavior: smooth; 
    }
    
    body { 
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif; 
        background-color: #f8fafc; 
        color: #0f172a; 
        -webkit-font-smoothing: antialiased;
    }

    /* Premium Article Typography & Spacing */
    .article-body {
        max-width: 100%;
        overflow-wrap: break-word;
    }

    .article-body p { 
        font-family: Georgia, Cambria, "Times New Roman", Times, serif; 
        margin-bottom: 2rem; 
        line-height: 1.85; 
        font-size: 1.125rem; 
        color: #334155; 
    }

    .article-body h2 { 
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
        color: #0f172a; 
        font-weight: 800; 
        font-size: 2rem; 
        margin-top: 3.5rem; 
        margin-bottom: 1.5rem; 
        letter-spacing: -0.025em;
        line-height: 1.3;
    }

    /* Elegant Drop Cap */
    .drop-cap::first-letter { 
        font-size: 4.2rem; 
        font-weight: 900; 
        float: left; 
        line-height: 0.8; 
        padding-right: 0.75rem; 
        padding-top: 0.25rem;
        color: #16a34a; 
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
    }

    /* High-Quality Stable Images & Animations */
    .image-wrapper {
        width: 100%;
        overflow: hidden;
        border-radius: 1.25rem;
        margin: 3rem 0 1rem 0;
        background-color: #f8fafc;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        aspect-ratio: 16 / 9;
        border: 1px solid #e2e8f0;
        position: relative;
    }

    /* SVG Images styling for perfect fit */
    .article-image { 
        width: 100%; 
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .image-wrapper:hover .article-image {
        transform: scale(1.03);
    }

    .image-caption { 
        text-align: center; 
        font-size: 0.875rem; 
        color: #64748b; 
        font-style: italic; 
        margin-bottom: 2.5rem; 
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* Modern Advertisement Blocks */
    .ad-wrapper { 
        background: #ffffff; 
        border-radius: 1rem; 
        padding: 1.5rem; 
        margin: 3rem 0; 
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05); 
        border: 1px solid #e2e8f0; 
        text-align: center; 
        transition: box-shadow 0.3s ease;
    }

    .ad-wrapper:hover {
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05), 0 4px 6px -4px rgba(0,0,0,0.05);
    }

    .ad-label { 
        font-size: 0.7rem; 
        text-transform: uppercase; 
        letter-spacing: 0.15em; 
        color: #94a3b8; 
        margin-bottom: 0.75rem; 
        display: block; 
        font-weight: 700;
    }

    .ad-slot { 
        background: repeating-linear-gradient(45deg, #f8fafc, #f8fafc 10px, #f1f5f9 10px, #f1f5f9 20px);
        border: 2px dashed #cbd5e1; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        color: #64748b; 
        font-weight: 600; 
        border-radius: 0.75rem; 
        width: 100%; 
        transition: border-color 0.3s ease;
    }

    .ad-banner { height: 90px; }
    .ad-rectangle { height: 250px; }

    /* Verification Box Styling */
    .verify-box { 
        background: linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%); 
        border: 1px solid #bbf7d0; 
        border-radius: 1.5rem; 
        padding: 3rem 2rem; 
        box-shadow: 0 20px 25px -5px rgba(34, 197, 94, 0.08), 0 8px 10px -6px rgba(34, 197, 94, 0.04); 
        position: relative; 
        overflow: hidden; 
    }

    .verify-box::before { 
        content: ''; 
        position: absolute; 
        top: 0; left: 0; 
        width: 100%; height: 5px; 
        background: linear-gradient(90deg, #22c55e, #10b981, #047857); 
    }

    .clickable-btn { 
        position: relative; 
        z-index: 100 !important; 
        pointer-events: auto !important; 
        cursor: pointer !important; 
    }
</style>

