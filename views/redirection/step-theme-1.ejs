
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f9fafb;
        color: #374151;
    }
    
    .article-body p {
        margin-bottom: 1.5rem;
        line-height: 1.8;
        font-size: 1.05rem;
    }
    
    .article-body h2, .article-body h3 {
        color: #111827;
        font-weight: 700;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }

    .article-image {
        width: 100%;
        border-radius: 12px;
        margin: 2rem 0;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        object-fit: cover;
    }

    /* Ad Placeholders */
    .ad-slot {
        width: 100%;
        background-color: #e5e7eb;
        border: 2px dashed #9ca3af;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-weight: 600;
        margin: 2rem 0;
        border-radius: 8px;
    }
    .ad-responsive { min-height: 250px; }
    .ad-banner { height: 90px; }

    /* Verification Box Styling */
    .verify-box {
        background: linear-gradient(to right, #eff6ff, #dbeafe);
        border: 2px solid #bfdbfe;
        border-radius: 12px;
        padding: 24px 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
</style>

<!-- Top Navigation -->
<header class="bg-white shadow-sm py-4 px-6 mb-8 border-b border-gray-200">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div class="text-2xl font-extrabold text-gray-800 tracking-tight">ShortInvest</div>
        <nav class="hidden md:flex space-x-6 text-sm font-semibold text-gray-600">
            <a href="#" class="hover:text-blue-600">Home</a>
            <a href="#" class="hover:text-blue-600">Finance</a>
            <a href="#" class="hover:text-blue-600">Investing</a>
            <a href="#" class="hover:text-blue-600">Contact</a>
        </nav>
    </div>
</header>

<main class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Left Column: Article Content & Verification -->
    <div class="lg:col-span-2 bg-white p-5 md:p-10 rounded-2xl shadow-sm border border-gray-100 border-l-4 border-l-blue-500 overflow-hidden">

        <!-- Article Header -->
        <header class="mb-6">
            <div class="text-sm text-blue-600 font-bold uppercase tracking-wider mb-2">Verification Step <%= step %> of <%= totalSteps %></div>
            <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 leading-tight mb-4">Best Personal Finance Advice to Start in 2026</h1>
            <div class="flex items-center text-gray-500 text-sm">
                <span class="font-semibold text-gray-700">By Starindia</span>
                <span class="mx-2">•</span>
                <span>February 18, 2026</span>
            </div>
        </header>

        <!-- Top Ad Slot -->
        <div class="ad-slot ad-responsive">
            [ AdSense Responsive Ad Slot ]
        </div>

        <!-- STEP 1: VERIFICATION TIMER BOX (Mobile Optimized) -->
        <div class="verify-box flex flex-col items-center justify-center my-8" id="step1-box">
            <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2 text-center">Please Wait for Verification...</h3>
            
            <!-- Timer ID required by timer-script (Fixed height stops bouncing) -->
            <div class="text-5xl font-black text-red-500 my-2 h-16 flex items-center justify-center" id="timerDisplay">10</div>
            
            <!-- Instruction Text ID required by timer-script (Fixed height) -->
            <p id="instructionText" class="text-sm md:text-base font-bold text-gray-500 mb-6 animate-pulse h-6 text-center">Analyzing traffic quality...</p>

            <!-- Custom Scroll Button (Uses Tailwind Flex for proper Android alignment) -->
            <button id="scroll-btn" class="hidden w-full max-w-sm mx-auto bg-blue-600 text-white font-bold py-4 px-4 rounded-full shadow-lg hover:bg-blue-700 transition-all items-center justify-center text-sm md:text-base" onclick="scrollToBottom()">
                Scroll Down & Click Continue <i class="fas fa-arrow-down ml-2"></i>
            </button>
        </div>

        <!-- Article Body -->
        <div class="article-body mt-8 text-gray-700">
            <p>Best Personal Finance advice Money management in 2026 is more important than ever before. As the costs of living increase, digital financial services, the shift in labor markets, and simple access to credit, novices can easily have a panic attack when working to establish financial security. Personal finance advice is not just about being wealthy, but rather it is about being in charge of your money and making smart choices and building a safe future.</p>

            <img src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=800&q=80" alt="Best Personal Finance Advice" class="article-image">
            
            <div class="ad-slot ad-banner">
                [ AdSense Inline Article Ad Slot ]
            </div>

            <h2 class="text-xl md:text-2xl font-bold">Developing a powerful budgeting routine</h2>
            <p>Personal finance advice is based on budgeting. Budgeting is not a constraint of your life; it only makes your money more organized so that you can use it in a better way. The novices ought to be directed to develop a basic and realistic budget that addresses the necessities such as rent, food, transport, and utilities as well as to make space to save and to enjoy themselves.</p>

            <img src="https://images.unsplash.com/photo-1579621970588-a35d0e7ab9b6?auto=format&fit=crop&w=800&q=80" alt="Smart Spending Behavior" class="article-image">
            
            <div class="ad-slot ad-responsive">
                [ AdSense In-feed Ad Slot ]
            </div>

            <h2 class="text-xl md:text-2xl font-bold">Conclusion</h2>
            <p>Personal finance advice for a start-up in 2026 is more about simplicity, discipline and smart habits. It does not require elaborate ideas or affluence to accomplish. You must have attitude, organization, discipline, and awareness.</p>
        </div>

        <!-- STEP 2: FINAL CONTINUE BUTTON (Targeted by timer-script, Mobile Optimized) -->
        <div class="mt-12 text-center pb-8 border-b border-gray-200 flex flex-col items-center justify-center" id="bottom-verify-section">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Verification Complete!</h3>
            
            <!-- Fixed height to prevent layout shifting -->
            <div id="bottom-waiting-text" class="text-gray-400 font-semibold italic mb-4 h-6 flex items-center justify-center">
                Please wait for the timer above to complete...
            </div>

            <!-- Continue Button ID required by timer-script -->
            <a id="continueBtn" href="#" class="hidden w-full max-w-sm mx-auto bg-blue-600 text-white py-4 px-4 rounded-full font-black text-lg hover:bg-blue-700 transition shadow-xl items-center justify-center">
                Continue to Next Step <i class="fas fa-arrow-right ml-2"></i>
            </a>
        </div>

        <!-- Bottom Ad Slot -->
        <div class="ad-slot ad-responsive">
            [ AdSense Bottom Ad Slot ]
        </div>

    </div>

    <!-- Right Column: Sidebar (Perfect for Sticky Ads) -->
    <aside class="lg:col-span-1 hidden lg:block">
        <div class="sticky top-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mb-6">
                <h3 class="text-lg font-bold border-b pb-2 mb-4">Advertisement</h3>
                <!-- Sidebar Ad 1 -->
                <div class="ad-slot ad-responsive h-64 w-full m-0">
                    [ Sidebar Ad Slot ]
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mb-6">
                <h3 class="text-lg font-bold border-b pb-2 mb-4">Recent Posts</h3>
                <ul class="space-y-3 text-sm text-gray-600">
                    <li class="hover:text-blue-600 cursor-pointer">Creating Multiple Revenue Sources</li>
                    <li class="hover:text-blue-600 cursor-pointer">Learning the Fundamentals of Investing</li>
                    <li class="hover:text-blue-600 cursor-pointer">Protect Your Financial Future</li>
                </ul>
            </div>
        </div>
    </aside>

</main>

<footer class="bg-gray-900 text-gray-400 text-center py-6 mt-12 text-sm">
    <p>Copyright © 2026 ShortInvest | Powered by Astra WordPress Theme</p>
</footer>

<!-- Backend Timer Script -->
<%- include('timer-script') %>

<!-- Fixed Mobile Bridge Logic (No auto-click/redirect from this frontend code) -->
<script>
    const customLogic = setInterval(() => {
        const timerVal = document.getElementById('timerDisplay').innerText;
        const continueBtn = document.getElementById('continueBtn');
        const scrollBtn = document.getElementById('scroll-btn');
        const waitingText = document.getElementById('bottom-waiting-text');
        
        // Use Tailwind classes instead of inline styles to prevent mobile layout breaking
        if (timerVal === "0" || timerVal === 0 || !continueBtn.classList.contains('hidden')) {
            // Show top scroll button
            scrollBtn.classList.remove('hidden');
            scrollBtn.classList.add('flex');
            
            // Hide "Please wait" text at the bottom
            waitingText.classList.add('hidden');
            
            // Ensure continueBtn displays properly as flex on mobile if unhidden by timer-script
            if(!continueBtn.classList.contains('hidden')) {
                continueBtn.classList.add('flex');
            }

            clearInterval(customLogic);
        }
    }, 500);

    // Smooth Scroll function
    function scrollToBottom() {
        document.getElementById('bottom-verify-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
</script>

