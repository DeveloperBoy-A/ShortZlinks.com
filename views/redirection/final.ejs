<%- include('../partials/header') %>
<main class="flex-grow flex items-center justify-center p-6 bg-gradient-to-br from-green-50 to-green-100 dark:from-gray-900 dark:to-gray-800">
    <div class="bg-white dark:bg-gray-800 p-10 rounded-2xl shadow-2xl text-center max-w-md w-full border-2 border-green-400">
        <i class="fas fa-check-circle text-6xl text-green-500 mb-6 drop-shadow-md"></i>
        <h2 class="text-3xl font-black mb-2 text-gray-800 dark:text-gray-100">Congratulations ðŸŽ‰</h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-2">Your destination link is securely ready.</p>
        <p class="text-sm text-gray-400 mb-8" id="autoRedirectNote">Redirecting automatically in <span id="finalCountdown">3</span>s...</p>

        <a href="<%= destination %>" id="finalDestinationLink" rel="nofollow noreferrer" class="block w-full bg-green-500 text-white py-4 rounded-xl font-bold text-xl hover:bg-green-600 transition shadow-lg hover:shadow-xl transform hover:-translate-y-1">
            Get Link <i class="fas fa-external-link-alt ml-2"></i>
        </a>
    </div>
</main>
<script>
    // Auto-redirect after a short pause; the button above still works immediately
    // as a manual fallback (useful if the browser blocks the automatic navigation).
    (function () {
        var seconds = 3;
        var el = document.getElementById('finalCountdown');
        var destination = document.getElementById('finalDestinationLink').href;
        var timer = setInterval(function () {
            seconds -= 1;
            if (el) el.textContent = seconds;
            if (seconds <= 0) {
                clearInterval(timer);
                window.location.href = destination;
            }
        }, 1000);
    })();
</script>
<%- include('../partials/footer') %>