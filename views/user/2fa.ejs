<%- include('../partials/header') %>
<div class="flex flex-1 flex-col md:flex-row overflow-hidden">
    <%- include('../partials/sidebar') %>
    <main class="flex-1 p-4 md:p-8 overflow-y-auto bg-gray-50 dark:bg-gray-900">
        <div class="max-w-2xl mx-auto">
            <h1 class="text-3xl font-bold mb-2 text-gray-900 dark:text-white"><i class="fas fa-shield-alt text-primary mr-2"></i> Two-Factor Authentication</h1>
            <p class="text-gray-500 dark:text-gray-400 mb-6">Add an extra layer of security to your account using an authenticator app (Google Authenticator, Authy, etc).</p>

            <% if (typeof success !== 'undefined' && success === 'enabled') { %>
                <div class="mb-6 p-4 rounded-lg bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 font-medium">
                    <i class="fas fa-check-circle mr-1"></i> Two-factor authentication is now enabled on your account.
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success === 'disabled') { %>
                <div class="mb-6 p-4 rounded-lg bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-400 font-medium">
                    <i class="fas fa-info-circle mr-1"></i> Two-factor authentication has been turned off.
                </div>
            <% } %>

            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6 md:p-8">

                <% if (user.twoFactorEnabled) { %>
                    <!-- ================= ENABLED STATE ================= -->
                    <div class="flex items-center gap-3 mb-6">
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-bold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
                            <i class="fas fa-check-circle"></i> Enabled
                        </span>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6">
                        Your account is protected. You will be asked for a 6-digit code from your authenticator app every time you log in.
                    </p>

                    <form action="/user/2fa/disable" method="POST" class="bg-red-50 dark:bg-red-900/20 p-5 rounded-xl border border-red-100 dark:border-red-900/50 space-y-3">
                        <label class="block text-sm font-bold text-red-700 dark:text-red-400">Disable Two-Factor Authentication</label>
                        <input type="password" name="currentPassword" required placeholder="Enter your current password to confirm"
                            class="w-full p-3 border rounded-lg bg-white dark:bg-gray-800 dark:border-gray-700 focus:ring-2 focus:ring-red-500 outline-none transition">
                        <button type="submit" class="bg-red-600 text-white px-6 py-2.5 rounded-lg font-bold hover:bg-red-700 transition">
                            Turn Off 2FA
                        </button>
                    </form>

                <% } else if (pendingSecret && qrCodeUrl) { %>
                    <!-- ================= SETUP IN PROGRESS: SCAN + CONFIRM ================= -->
                    <div class="flex items-center gap-3 mb-6">
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-bold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">
                            <i class="fas fa-clock"></i> Setup In Progress
                        </span>
                    </div>

                    <ol class="space-y-4 mb-6">
                        <li class="flex gap-3">
                            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">1</span>
                            <div>
                                <p class="font-semibold text-gray-800 dark:text-gray-200">Scan this QR code with your authenticator app</p>
                                <img src="<%= qrCodeUrl %>" alt="2FA QR Code" class="mt-3 rounded-lg border dark:border-gray-700 w-44 h-44">
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">2</span>
                            <div class="w-full">
                                <p class="font-semibold text-gray-800 dark:text-gray-200 mb-1">Can't scan? Enter this code manually:</p>
                                <code class="block bg-gray-100 dark:bg-gray-900 px-3 py-2 rounded text-sm tracking-widest select-all"><%= pendingSecret %></code>
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">3</span>
                            <div class="w-full">
                                <p class="font-semibold text-gray-800 dark:text-gray-200 mb-2">Enter the 6-digit code it shows to confirm</p>
                                <form action="/user/2fa/confirm" method="POST" class="flex flex-col sm:flex-row gap-3">
                                    <input type="text" name="token" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" placeholder="000000"
                                        class="flex-1 p-3 text-center text-xl tracking-[0.4em] border rounded-lg dark:bg-gray-900 dark:border-gray-700 focus:ring-2 focus:ring-primary outline-none">
                                    <button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg font-bold hover:bg-indigo-700 transition">
                                        Confirm &amp; Enable
                                    </button>
                                </form>
                            </div>
                        </li>
                    </ol>

                    <form action="/user/2fa/setup" method="POST">
                        <button type="submit" class="text-sm text-gray-500 hover:underline">
                            <i class="fas fa-sync-alt mr-1"></i> Generate a new QR code instead
                        </button>
                    </form>

                <% } else { %>
                    <!-- ================= NOT ENABLED ================= -->
                    <div class="flex items-center gap-3 mb-6">
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-bold bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                            <i class="fas fa-times-circle"></i> Not Enabled
                        </span>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6">
                        Two-factor authentication isn't turned on yet. We recommend enabling it, especially since your account can hold a real dollar balance.
                    </p>
                    <form action="/user/2fa/setup" method="POST">
                        <button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg font-bold hover:bg-indigo-700 transition shadow-md">
                            <i class="fas fa-qrcode mr-2"></i> Set Up Two-Factor Authentication
                        </button>
                    </form>
                <% } %>

            </div>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>