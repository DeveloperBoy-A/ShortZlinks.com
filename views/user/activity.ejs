<%- include('../partials/header') %>
<div class="flex flex-1 flex-col md:flex-row overflow-hidden">
    <main class="flex-1 p-4 md:p-8 overflow-y-auto bg-gray-50 dark:bg-gray-900">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-3xl font-bold mb-2 text-gray-900 dark:text-white"><i class="fas fa-history text-primary mr-2"></i> Account Activity</h1>
            <p class="text-gray-500 dark:text-gray-400 mb-6">A record of recent sign-ins to your account, most recent first.</p>

            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md overflow-hidden">
                <% if (activity && activity.length) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 dark:bg-gray-900/40 text-xs uppercase text-gray-500 dark:text-gray-400">
                                <tr>
                                    <th class="px-6 py-3">Status</th>
                                    <th class="px-6 py-3">IP Address</th>
                                    <th class="px-6 py-3">Device / Browser</th>
                                    <th class="px-6 py-3">When</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                                <% activity.forEach(function(entry){ %>
                                    <tr>
                                        <td class="px-6 py-4">
                                            <% if (entry.status === 'success') { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400"><i class="fas fa-check-circle"></i> Successful Login</span>
                                            <% } else if (entry.status === 'failed_2fa') { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400"><i class="fas fa-shield-alt"></i> Wrong 2FA Code</span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400"><i class="fas fa-times-circle"></i> Failed Password</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 font-mono"><%= entry.ipAddress || 'Unknown' %></td>
                                        <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 max-w-xs truncate" title="<%= entry.userAgent %>"><%= entry.userAgent || 'Unknown' %></td>
                                        <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= new Date(entry.createdAt).toLocaleString() %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-10 text-center text-gray-500">
                        <i class="fas fa-inbox text-3xl mb-3 block"></i>
                        No login activity recorded yet.
                    </div>
                <% } %>
            </div>

            <p class="text-xs text-gray-400 mt-4">
                <i class="fas fa-info-circle mr-1"></i> Don't recognize a login? Change your password immediately from
                <a href="/user/settings#password" class="text-primary hover:underline">Settings</a> and consider enabling
                <a href="/user/2fa" class="text-primary hover:underline">Two-Factor Authentication</a>.
            </p>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>