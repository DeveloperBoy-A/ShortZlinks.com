            <h1 class="text-4xl md:text-6xl font-extrabold mb-5 leading-tight text-gray-900 dark:text-white">
                Shorten <span class="bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary glowing-text">Share</span> &amp; Earn Money
            </h1>

            <div class="inline-flex items-center gap-2 bg-white dark:bg-gray-800 shadow-md rounded-full px-4 py-2 mb-6 border border-gray-100 dark:border-gray-700">
                <i class="fas fa-dollar-sign text-green-500"></i>
