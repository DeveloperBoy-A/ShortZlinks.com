    const _settings   = typeof settings !== 'undefined' ? settings : {};
    const _cpm        = (_settings.baseCpm !== undefined && _settings.baseCpm !== null) ? Number(_settings.baseCpm) : 5;
    const _commission = (_settings.adminCommissionPercent !== undefined) ? _settings.adminCommissionPercent : 20;
    const _stats       = typeof stats !== 'undefined' ? stats : {};
    const fmt = (n) => Number(n || 0).toLocaleString('en-US');
%>

<!-- ============================== HERO ============================== -->
