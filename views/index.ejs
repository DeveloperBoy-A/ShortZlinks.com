<!-- ============================== SCRIPTS ============================== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
    // Register GSAP ScrollTrigger
    gsap.registerPlugin(ScrollTrigger);

    // ---- Initial load: left <-> right slide-in (the "lift/left-right" entrance animation) ----
    gsap.from(".hero-slide-left", { duration: 1.2, x: -100, opacity: 0, ease: "power3.out" });
    gsap.from(".hero-slide-right", { duration: 1.2, x: 100, opacity: 0, ease: "power3.out", delay: 0.2 });

    // ---- Continuous floating animation for the hero graphic cards ----
    gsap.to(".floating-icon-a", { y: 14, duration: 2.6, yoyo: true, repeat: -1, ease: "sine.inOut" });
    gsap.to(".floating-icon-b", { y: -16, duration: 3.1, yoyo: true, repeat: -1, ease: "sine.inOut", delay: 0.2 });
    gsap.to(".floating-icon-c", { y: 16, duration: 2.8, yoyo: true, repeat: -1, ease: "sine.inOut", delay: 0.4 });
    gsap.to(".floating-icon-d", { y: -14, duration: 3.3, yoyo: true, repeat: -1, ease: "sine.inOut", delay: 0.1 });

    // ---- Scroll reveal for section headings ----
    document.querySelectorAll(".reveal-text").forEach((el) => {
        gsap.from(el, {
            scrollTrigger: { trigger: el, start: "top 85%" },
            y: 50, opacity: 0, duration: 1
        });
    });

    // ---- Scroll reveal, staggered, for every card-like block on the page ----
    document.querySelectorAll("section").forEach((section) => {
        const cards = section.querySelectorAll(".feature-card");
        if (!cards.length) return;
        gsap.from(cards, {
            scrollTrigger: { trigger: section, start: "top 75%" },
            y: 80, opacity: 0, duration: 0.9, stagger: 0.2, ease: "back.out(1.6)"
        });
    });

    // ---- Stat counters ----
    document.querySelectorAll(".stat-number").forEach((el) => {
        const target = parseInt(el.getAttribute("data-target"), 10) || 0;
        const counter = { val: 0 };
        ScrollTrigger.create({
            trigger: el,
            start: "top 90%",
            once: true,
            onEnter: () => {
                gsap.to(counter, {
                    val: target,
                    duration: 1.8,
                    ease: "power1.out",
                    onUpdate: () => { el.textContent = Math.floor(counter.val).toLocaleString('en-US'); }
                });
            }
        });
    });
</script>

<script>
    // ---- Quick shorten form: guests must sign in to actually create a link ----
    function handleQuickShorten(e) {
        e.preventDefault();
        const input = document.getElementById('quickUrlInput');
        const msg = document.getElementById('quickShortenMsg');
        const url = input.value.trim();

        if (!url) {
            msg.textContent = 'Please paste a URL first.';
            msg.className = 'text-sm mb-4 text-red-500';
            return false;
        }
        try { sessionStorage.setItem('shortz_pending_url', url); } catch (err) {}

        msg.textContent = 'Almost there â€” please login or sign up to finish shortening this link.';
        msg.className = 'text-sm mb-4 text-primary font-semibold';

        setTimeout(() => { window.location.href = '/login'; }, 700);
        return false;
    }

    // ---- FAQ accordion ----
    document.querySelectorAll('.faq-trigger').forEach((btn) => {
        btn.addEventListener('click', () => {
            const panel = btn.nextElementSibling;
            const icon = btn.querySelector('.faq-icon');
            const isOpen = !panel.classList.contains('hidden');

            document.querySelectorAll('.faq-panel').forEach((p) => p.classList.add('hidden'));
            document.querySelectorAll('.faq-icon').forEach((i) => i.classList.replace('fa-minus', 'fa-plus'));

            if (!isOpen) {
                panel.classList.remove('hidden');
                icon.classList.replace('fa-plus', 'fa-minus');
            }
        });
    });

    // ---- Testimonial rotator ----
    const testimonials = [
        { text: "Honestly, I haven't come across a smoother link-shortening platform than this one. It feels like I'm getting rewarded twice for the same traffic I already share elsewhere.", author: "Aarav Mehta" },
        { text: "Payouts actually land on time, and the CPM rates keep getting better. This is the first shortener I've stuck with for more than a month.", author: "Sara Khan" },
        { text: "Simple dashboard, real stats, and support that replies fast. Exactly what I needed to start monetizing my Telegram channel links.", author: "Daniyal Raza" }
    ];
    let tIndex = 0;
    const tTextEl = document.getElementById('testimonialText');
    const tAuthorEl = document.getElementById('testimonialAuthor');
    const dots = document.querySelectorAll('.testimonial-dot');

    function showTestimonial(i) {
        tIndex = i;
        gsap.to('#testimonialBubble', {
            opacity: 0, y: 10, duration: 0.25, onComplete: () => {
                tTextEl.textContent = testimonials[i].text;
                tAuthorEl.textContent = testimonials[i].author;
                gsap.to('#testimonialBubble', { opacity: 1, y: 0, duration: 0.35 });
            }
        });
        dots.forEach((d, idx) => {
            d.classList.toggle('bg-primary', idx === i);
            d.classList.toggle('bg-gray-300', idx !== i);
        });
    }

    dots.forEach((d) => d.addEventListener('click', () => showTestimonial(parseInt(d.dataset.i, 10))));
    setInterval(() => showTestimonial((tIndex + 1) % testimonials.length), 6000);
</script>

<style>
    /* 3D Perspective for the hero graphic */
    .perspective-1000 { perspective: 1000px; }

    /* Background blob animation */
    @keyframes blob {
        0% { transform: translate(0px, 0px) scale(1); }
        33% { transform: translate(30px, -50px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
        100% { transform: translate(0px, 0px) scale(1); }
    }
    .animate-blob { animation: blob 7s infinite; }
    .animation-delay-2000 { animation-delay: 2s; }

    .glowing-text { text-shadow: 0 0 30px rgba(99,102,241,0.25); }
</style>

