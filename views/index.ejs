                    EARN UP TO <span class="text-green-500 font-bold">$<%= _cpm.toFixed(2) %></span> / 1000 VIEWS
                </span>
            </div>

            <!-- Quick shorten form -->
            <form id="quickShortenForm" class="flex flex-col sm:flex-row gap-3 mb-6" onsubmit="return handleQuickShorten(event)">
